{
  "source": "package/package.json of each npm tarball as published on registry.npmjs.org (read 2026-10-10), unchanged",
  "manifests": {
    "pdfjs-dist": {
      "name": "pdfjs-dist",
      "version": "6.4.299",
      "main": "build/pdf.mjs",
      "types": "types/src/pdf.d.ts",
      "description": "Generic build of Mozilla's PDF.js library.",
      "keywords": [
        "Mozilla",
        "pdf",
        "pdf.js"
      ],
      "homepage": "https://mozilla.github.io/pdf.js/",
